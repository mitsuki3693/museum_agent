# Copy to .env; do not commit .env or paste keys into chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MUSEUM_STORAGE=memory
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=museum_agent
MUSEUM_EMBEDDING=local
MUSEUM_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MUSEUM_ADMIN_TOKEN=
# Mongo runtime persistence (source corpus remains fixed JSON). See docs/persistence.md.
# MUSEUM_STORAGE=mongo
# MUSEUM_MONGODUMP=.runtime/tools/mongodb/mongodb-database-tools-windows-x86_64-100.19.0/bin/mongodump.exe
# MUSEUM_BACKUP_DIR=.runtime/backups
# MUSEUM_DAILY_BACKUP=true
# Optional local-only image gallery; omit both to use caption/text retrieval.
# MUSEUM_VISUAL_MANIFEST=data/private/visual-references.json
# MUSEUM_VISUAL_MODEL=models/dinov2-small
# Optional local-only route map, with sources and a review expiry date.
# MUSEUM_ROUTE_MANIFEST=data/private/va-europe-route.json
# Optional: one real-floor-map demo. Original map tiles stay local.
# MUSEUM_FLOOR_DEMO_MANIFEST=data/private/va-floor-map/case.json
# Optional: read-only simulated staff scenario; no internal records or live actions.
# MUSEUM_OPERATIONS_DEMO_MANIFEST=data/private/operations-demo.json
