# Copy to .env; do not commit .env or paste keys into chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MUSEUM_STORAGE=memory
# Experimental structured claim/relevance/identity review; keep legacy until accepted.
MUSEUM_VERIFIER_POLICY=legacy
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=museum_agent
MUSEUM_EMBEDDING=local
MUSEUM_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Opt-in after text/answer acceptance; original restores the previous dense index.
# administrative preserves descriptive fields; experimental, not enabled by default.
# filtered excluded useful attributes and failed metadata acceptance; avoid enabling it.
MUSEUM_DENSE_VIEW=original
# Optional text-only rerank. Off by default; existing/photo search stays intact.
MUSEUM_TEXT_RERANK=false
# Opt-in length-grouped batches plus stable identity order within identical evidence.
# Preserves candidate count and raw scores; no broad score rounding.
MUSEUM_RERANK_SORT_BY_LENGTH=false
# Experimental Chinese BM25F + source bridge + evidence controls. Requires
# MUSEUM_SEARCH_FIELDS. Includes a separate Chinese fallback; not accepted yet.
MUSEUM_CHINESE_RECALL=false
# Opt-in bilingual query expansion for Chinese fallback only. Requires Chinese recall.
# Two distinct glossary concepts are required; authoritative sources stay unchanged.
# Catalogue mode below also expands the neural worker's candidate pool.
MUSEUM_FALLBACK_GLOSSARY=false
# Retrieval-only category/motif/name translations. Requires fallback glossary.
# Keep false to reproduce the previous glossary; see docs/catalogue-glossary.md.
MUSEUM_CATALOGUE_GLOSSARY=false
# Explicit full-author/displayed-date lookup; preserves approximate/range dates.
MUSEUM_METADATA_ROUTING=false
# Optional source-validated Chinese title lookup; general BM25F is still offline.
# MUSEUM_SEARCH_FIELDS=data/private/chinese-recall-v2-web_config.json
MUSEUM_SEARCH_ALLOW_DRAFTS=false
# Local pinned model with verified download-manifest.json; no model API.
# MUSEUM_RERANK_MODEL=models/bge-reranker-v2-m3
MUSEUM_RERANK_TIMEOUT=8
MUSEUM_RERANK_STARTUP_TIMEOUT=60
# Busy falls back immediately. Timeout/error kills the worker and opens the
# circuit until service restart; inspect health.text_rerank and Trace.rerank.
MUSEUM_ADMIN_TOKEN=
# Mongo runtime persistence (source corpus remains fixed JSON). See docs/persistence.md.
# MUSEUM_STORAGE=mongo
# MUSEUM_MONGODUMP=.runtime/tools/mongodb/mongodb-database-tools-windows-x86_64-100.19.0/bin/mongodump.exe
# MUSEUM_BACKUP_DIR=.runtime/backups
# MUSEUM_DAILY_BACKUP=true
# Optional local-only image gallery; omit both to use caption/text retrieval.
# MUSEUM_VISUAL_MANIFEST=data/private/visual-references.json
# MUSEUM_VISUAL_MODEL=models/dinov2-small
# Derived administrator-reference features only; never stores uploaded photos.
# MUSEUM_VISUAL_CACHE=.runtime/visual-features
# Experimental verification: same candidates, up to two reference photos each.
# MUSEUM_PHOTO_REFERENCE_MODE=single
# Independent verification experiments; rollback is legacy. No new vision weights.
# MUSEUM_PHOTO_VERIFICATION=legacy
# Optional local-only route map, with sources and a review expiry date.
# MUSEUM_ROUTE_MANIFEST=data/private/va-europe-route.json
# Optional: one real-floor-map demo. Original map tiles stay local.
# MUSEUM_FLOOR_DEMO_MANIFEST=data/private/va-floor-map/case.json
# Optional: read-only simulated staff scenario; no internal records or live actions.
# MUSEUM_OPERATIONS_DEMO_MANIFEST=data/private/operations-demo.json
